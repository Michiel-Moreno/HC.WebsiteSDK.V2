{
  "name": "@hello-customer/website-touchpoint-v2",
  "version": "2.0.2",
  "description": "Library for embedding Hello Customer surveys",
  "main": "build/umd/website-touchpoint-v2.js",
  "typings": "build/module/index.d.ts",
  "module": "build/module/index.js",
  "repository": "https://github.com/hellocustomer/HC.WebsiteSDK.V2.git",
  "license": "MIT",
  "keywords": [],
  "scripts": {
    "build": "run-p build:*",
    "build:cdn": "rollup -c rollup.config.ts --bundleConfigAsCjs",
    "build:module": "tsc -p tsconfig.module.json",
    "fix": "run-s fix:*",
    "fix:prettier": "prettier \"src/**/*.ts\" --write",
    "fix:lint": "eslint src --ext .ts --fix",
    "test": "run-s build test:*",
    "test:lint": "eslint src --ext .ts",
    "test:spelling": "cspell \"{README.md,.github/*.md,src/**/*.ts}\"",
    "test:unit": "jest --passWithNoTests",
    "check-cli": "run-s test",
    "watch:build": "tsc -p tsconfig.json -w",
    "watch:test": "nyc --silent ava --watch",
    "cov": "run-s build test:unit cov:html cov:lcov && open-cli coverage/index.html",
    "cov:html": "nyc report --reporter=html",
    "cov:lcov": "nyc report --reporter=lcov",
    "cov:send": "run-s cov:lcov && codecov",
    "cov:check": "nyc report && nyc check-coverage --lines 100 --functions 100 --branches 100",
    "doc": "run-s doc:html && open-cli docs/index.html",
    "doc:html": "typedoc src/ --exclude **/*.spec.ts --out docs",
    "doc:json": "typedoc src/ --exclude **/*.spec.ts --json docs/typedoc.json",
    "version": "standard-version --tag-prefix=''",
    "reset-hard": "git clean -dfx && git reset --hard && npm i",
    "checkout-master": "git checkout master && git pull --tags origin master",
    "release:prepare": "run-s reset-hard checkout-master test doc:html version",
    "release:push": "git push --follow-tags origin master --no-verify",
    "release:publish": "npm publish --access public --tag latest",
    "release": "run-s release:*",
    "prepare": "husky"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.5.0",
    "@commitlint/config-conventional": "^19.5.0",
    "@istanbuljs/nyc-config-typescript": "latest",
    "@rollup/plugin-commonjs": "^28.0.5",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^15.3.0",
    "@rollup/plugin-terser": "^0.4.4",
    "@rollup/plugin-typescript": "^12.1.4",
    "@types/jest": "^29.5.14",
    "@types/node": "20.17.9",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "codecov": "^3.5.0",
    "cspell": "^8.16.1",
    "cz-conventional-changelog": "^3.0.1",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-eslint-comments": "^3.2.0",
    "eslint-plugin-functional": "^6.6.3",
    "eslint-plugin-import": "2.32.0",
    "gh-pages": "^6.3.0",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^30.2.0",
    "lint-staged": "^15.2.7",
    "npm-run-all": "^4.1.5",
    "nyc": "^17.1.0",
    "open-cli": "^8.0.0",
    "prettier": "^3.3.3",
    "rollup": "^4.52.4",
    "rollup-plugin-visualizer": "^6.0.5",
    "standard-version": "9.5.0",
    "ts-jest": "^29.4.5",
    "ts-node": "^10.9.2",
    "tslib": "^2.8.1",
    "typedoc": "^0.26.11",
    "typescript": "^4.9.5"
  },
  "files": [
    "build/main",
    "build/module",
    "!**/*.spec.*",
    "!**/*.json",
    "CHANGELOG.md",
    "LICENSE",
    "README.md"
  ],
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  },
  "prettier": {
    "singleQuote": true
  },
  "nyc": {
    "extends": "@istanbuljs/nyc-config-typescript",
    "exclude": [
      "**/*.spec.js"
    ]
  }
}
